# Local JSON-RPC endpoint (e.g. Anvil: `anvil`, or Ganache: `npx ganache`),
# or a testnet RPC URL (Infura/Alchemy Sepolia, etc.)
RPC_URL=http://127.0.0.1:8545

# Deployer/client private key (used only to deploy - never commit a real key)
PRIVATE_KEY=0xyour_client_private_key

# The freelancer's wallet address (constructor argument)
FREELANCER_ADDRESS=0xfreelancer_wallet_address
